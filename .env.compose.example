# Copy to .env.compose.local and replace each placeholder locally.
# Use `docker compose --env-file .env.compose.local ...` so the existing
# PostgreSQL-oriented root .env is never used or overwritten.
MYSQL_DATABASE=careerpilot
MYSQL_USER=careerpilot
MYSQL_PASSWORD=replace-with-a-unique-local-database-secret
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-secret
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_SECONDS=900
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
